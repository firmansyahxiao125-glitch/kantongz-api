# KANTONGZ — templat lingkungan PRODUKSI.
#
#   cp .env.prod.example .env.prod
#
# JANGAN pernah men-commit `.env.prod` yang terisi. `.gitignore` sudah
# menutupnya, tetapi kebiasaan yang bergantung pada satu baris `.gitignore`
# adalah kebiasaan yang akan gagal pada repositori berikutnya.
#
# Setiap nilai bertanda WAJIB dibaca `docker-compose.prod.yml` lewat
# `${VAR:?pesan}`. Compose MENOLAK jalan bila kosong — sengaja, supaya
# penyebaran gagal berisik alih-alih berjalan dengan bawaan pengembangan.

# ── domain & TLS ───────────────────────────────────────────────────────
# Domain sungguhan yang rekaman DNS-nya sudah menunjuk ke mesin ini.
# Gunakan `localhost` untuk uji coba lokal — Caddy memakai CA internalnya
# sendiri dan tidak menghubungi Let's Encrypt sama sekali.
KANTONGZ_DOMAIN=localhost

# Surel ACME. Let's Encrypt memakainya untuk memperingatkan sebelum
# sertifikat gagal diperbarui — dan itu satu-satunya peringatan yang datang.
# Kosongkan saat KANTONGZ_DOMAIN=localhost.
ACME_EMAIL=

# ── basis data ─────────────────────────────────────────────────────────
POSTGRES_USER=kantongz
POSTGRES_DB=kantongz
# BANGKITKAN, jangan diketik. Sandi yang diketik manusia dapat ditebak:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Ukuran kolam koneksi. 10 adalah tebakan yang masuk akal, BUKAN hasil
# pengukuran — lihat docs/PRODUCTION_CHECKLIST.md. Sesuaikan setelah uji beban.
DATABASE_POOL_MAX=10

# ── redis ──────────────────────────────────────────────────────────────
#   openssl rand -base64 32
REDIS_PASSWORD=

# ── token ──────────────────────────────────────────────────────────────
# Bangkitkan pasangan kunci dan master key sekaligus:
#   npm run keys:generate
#
# PEM ditulis SATU BARIS dengan `\n` harfiah; `loadConfig` memulihkannya.
# Di produksi sungguhan nilai-nilai ini datang dari KMS, bukan dari berkas —
# berkas ini adalah jembatan sampai KMS terpasang.
JWT_ISSUER=https://api.kantongz.example
JWT_AUDIENCE=kantongz-web
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MASTER_KEY=
HMAC_KEY_VERSION=1

# Rotasi kunci: isi PREVIOUS dengan pasangan LAMA saat memutar, supaya token
# yang sudah beredar tetap dapat diverifikasi selama masa peralihan.
# JWT_PREVIOUS_PRIVATE_KEY=
# JWT_PREVIOUS_PUBLIC_KEY=

# ── asal peramban ──────────────────────────────────────────────────────
# Dipisahkan koma, TANPA garis miring di ujung, dan HANYA asal produksi.
# Daftar yang salah mengizinkan situs mana pun memanggil API ini dengan
# kredensial pengguna.
CORS_ORIGINS=https://kantongz.example

# Dipanggang ke bundel web SAAT BUILD. Mengubahnya menuntut build ulang citra;
# mengubahnya di sini saja tidak berpengaruh apa pun.
PUBLIC_API_URL=https://kantongz.example

# ── surel ──────────────────────────────────────────────────────────────
# SMTP mana pun. Gmail, SES, Postmark, atau relay milik sendiri.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
MAIL_FROM=no-reply@kantongz.example
# Autentikasi SMTP dan Ollama hidup di deploy/optional.env — lihat
# deploy/optional.env.example. Keduanya TIDAK boleh dikosongkan di sini:
# string kosong ditolak skema konfigurasi, sementara ketiadaan diterima.

# ── pengamatan (hanya bila overlay dijalankan) ─────────────────────────
# Dibaca `docker-compose.observability.yml`. WAJIB bila overlay itu dipakai —
# tanpa ini Compose menolak jalan. Bangkitkan, jangan diketik:
#   openssl rand -base64 24
#
# Grafana menampilkan seluruh bentuk lalu lintas dan isi log. Sandi lemah di
# sini setara membuka log produksi ke siapa pun yang menebaknya.
GRAFANA_PASSWORD=

# ── log ────────────────────────────────────────────────────────────────
# `debug` MEMBOCORKAN badan permintaan ke log. Jangan pernah di produksi.
LOG_LEVEL=info

# ── citra ──────────────────────────────────────────────────────────────
# Disetel pipeline rilis ke tag ber-versi. Bawaan `:latest` benar untuk
# `docker compose build` lokal dan SALAH untuk penyebaran sungguhan —
# `latest` membuat rollback mustahil karena tidak ada yang bisa dituju.
# API_IMAGE=ghcr.io/<owner>/kantongz-api:v1.0.0
# WEB_IMAGE=ghcr.io/<owner>/kantongz-web:v1.0.0
