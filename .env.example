# Disalin ke .env untuk pengembangan lokal. JANGAN pernah di-commit terisi.
# Twelve-Factor: seluruh konfigurasi datang dari lingkungan, tanpa kecuali.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# Basis data
DATABASE_URL=postgres://kantongz:kantongz@localhost:5432/kantongz
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Identitas token — §4.2 M3_SPEC
JWT_ISSUER=https://api.kantongz.id
JWT_AUDIENCE=kantongz-mobile

# Bahan rahasia — §4.3 dan §7 M3_SPEC.
# Bangkitkan untuk pengembangan lokal dengan:  npm run keys:generate
# PEM ditulis satu baris memakai \n harfiah; loadConfig memulihkannya.
# Di produksi seluruh nilai ini datang dari KMS, bukan dari berkas.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MASTER_KEY=
HMAC_KEY_VERSION=1

# Asal peramban yang boleh memanggil langsung, dipisahkan koma. Kosong berarti
# tidak ada asal peramban yang diizinkan — benar untuk penyebaran khusus-mobile.
CORS_ORIGINS=http://localhost:3100

# Email lewat SMTP — penyedia BAWAAN. `docker compose up` menyediakan Mailpit di
# :1025 dengan antarmuka web di http://localhost:8025. Tanpa akun, tanpa biaya.
# Untuk Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, dan sandi aplikasi.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@kantongz.id
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Model LOKAL lewat Ollama — penyedia BAWAAN untuk ringkasan dan simulasi.
#   ollama pull llama3.2:3b
# Tanpa Ollama, ringkasan tetap terbit dengan narasi bertemplat, dan aplikasi
# mengatakannya kepada pengguna. Tidak ada yang gagal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Penyedia awan — OPSIONAL, tidak pernah bawaan. Diperiksa hanya setelah
# Ollama terbukti tidak berjalan.
# ANTHROPIC_API_KEY=
# MAIL_ENDPOINT=
# MAIL_API_KEY=

# Pasangan kunci sebelumnya, hanya selama masa tumpang tindih rotasi. §4.3
# Harus diisi berpasangan atau tidak sama sekali — boot menolak setengahnya.
# JWT_PREVIOUS_PRIVATE_KEY=
# JWT_PREVIOUS_PUBLIC_KEY=

# ── Penyetelan opsional ────────────────────────────────────────────────
#
# Seluruhnya punya nilai bawaan di `src/config/index.ts`, jadi tidak ada yang
# perlu diisi agar aplikasi berjalan. Didaftarkan di sini karena nilai bawaan
# yang hanya hidup di kode adalah nilai yang tidak pernah ditemukan operator
# sampai ia terpaksa mencarinya — biasanya saat sedang bermasalah.
#
# Nilai yang tertulis di bawah ADALAH bawaannya, disalin dari kode.

# Batas waktu satu panggilan model lokal. Naikkan pada mesin tanpa GPU.
# OLLAMA_TIMEOUT_MS=30000

# Model awan, dipakai HANYA jika ANTHROPIC_API_KEY diisi dan Ollama mati.
# ANTHROPIC_MODEL=claude-opus-5

# Bahasa OCR struk. Kode Tesseract, dipisah tanda tambah.
# OCR_LANGUAGES=ind+eng

# Pekerja outbox: berapa pesan per putaran, dan jeda antar putaran.
# OUTBOX_BATCH_SIZE=20
# OUTBOX_INTERVAL_MS=2000

# Batas waktu satu percakapan SMTP.
# SMTP_TIMEOUT_MS=10000
