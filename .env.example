# Disalin ke .env untuk pengembangan lokal. JANGAN pernah di-commit terisi.
# Twelve-Factor: seluruh konfigurasi datang dari lingkungan, tanpa kecuali.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# Basis data
DATABASE_URL=postgres://kantongz:kantongz@localhost:5432/kantongz
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Identitas token — §4.2 M3_SPEC
JWT_ISSUER=https://api.kantongz.id
JWT_AUDIENCE=kantongz-mobile
