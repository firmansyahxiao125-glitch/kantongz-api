{
  "name": "kantongz-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:standalone": "node --import tsx src/standalone.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "keys:generate": "node scripts/generate-keys.mjs",
    "e2e": "bash scripts/e2e.sh",
    "verify": "bash scripts/verify-standalone.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
