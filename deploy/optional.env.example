# Variabel OPSIONAL untuk susunan produksi.
#
#   cp deploy/optional.env.example deploy/optional.env
#
# HAPUS baris yang tidak dipakai — JANGAN kosongkan nilainya. Skema
# konfigurasi menolak string kosong di tempat ia menerima ketiadaan, dan
# baris kosong akan membuat API gagal boot dengan pesan yang membingungkan:
#
#   SMTP_USER: Too small: expected string to have >=1 characters
#
# Berkas ini boleh TIDAK ADA sama sekali. Itu keadaan yang benar untuk relay
# SMTP tanpa autentikasi dan penyebaran tanpa Ollama.

# Autentikasi SMTP. Hapus keduanya bila relay-mu tidak menuntut login.
# SMTP_USER=
# SMTP_PASSWORD=

# Model bahasa lokal. Tanpa ini ringkasan naratif memakai templat, dan
# TIDAK ADA fitur yang hilang — layar menyatakan sumbernya lewat
# `narrativeSource`.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:3b

# Rotasi kunci JWT. Isi dengan pasangan LAMA saat memutar, supaya token yang
# sudah beredar tetap dapat diverifikasi selama masa peralihan.
# JWT_PREVIOUS_PRIVATE_KEY=
# JWT_PREVIOUS_PUBLIC_KEY=

# Penghapusan PERMANEN. F4. MATI kecuali baris ini benar-benar dinyalakan.
#
# Ini satu-satunya kemampuan di sistem ini yang kegagalannya tidak dapat
# diperbaiki: saldo dihitung ulang, kategori diganti, pengingat dikirim lagi —
# data yang benar-benar dihapus tidak kembali kepada siapa pun.
#
# Menyalakannya TIDAK langsung menghapus apa pun. Ia hanya membuka rute
# `POST /v1/account/purge`, yang sendirinya masih menuntut `dryRun: false`
# secara eksplisit dan hanya menyentuh baris yang SUDAH dihapus-lunak dan
# sudah melewati masa tunggu di bawah.
#
# Biarkan mati kecuali kamu memang menjalankan kewajiban penghapusan data.
# PURGE_ENABLED=true

# Masa tunggu sesudah hapus lunak, sebelum boleh dihapus permanen.
# Bawaan 30 hari, serendah-rendahnya 7 — dijepit lagi di dalam kode, karena
# nol berarti menghapus permanen yang baru saja ditekan salah semenit lalu.
# PURGE_AFTER_DAYS=30
