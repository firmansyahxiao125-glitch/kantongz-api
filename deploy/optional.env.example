# Variabel OPSIONAL untuk susunan produksi.
#
#   cp deploy/optional.env.example deploy/optional.env
#
# HAPUS baris yang tidak dipakai — JANGAN kosongkan nilainya. Skema
# konfigurasi menolak string kosong di tempat ia menerima ketiadaan, dan
# baris kosong akan membuat API gagal boot dengan pesan yang membingungkan:
#
#   SMTP_USER: Too small: expected string to have >=1 characters
#
# Berkas ini boleh TIDAK ADA sama sekali. Itu keadaan yang benar untuk relay
# SMTP tanpa autentikasi dan penyebaran tanpa Ollama.

# Autentikasi SMTP. Hapus keduanya bila relay-mu tidak menuntut login.
# SMTP_USER=
# SMTP_PASSWORD=

# Model bahasa lokal. Tanpa ini ringkasan naratif memakai templat, dan
# TIDAK ADA fitur yang hilang — layar menyatakan sumbernya lewat
# `narrativeSource`.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:3b

# Rotasi kunci JWT. Isi dengan pasangan LAMA saat memutar, supaya token yang
# sudah beredar tetap dapat diverifikasi selama masa peralihan.
# JWT_PREVIOUS_PRIVATE_KEY=
# JWT_PREVIOUS_PUBLIC_KEY=
