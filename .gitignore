node_modules/
dist/
.env
.env.*
# Templat DIKECUALIKAN satu per satu.
#
# `!.env.example` saja tidak cukup: `.env.prod.example` juga cocok `.env.*`,
# dan ia lolos dari repositori tanpa satu pun peringatan. Operator yang
# mengkloning tidak menemukan templat produksi sama sekali — dan yang hilang
# adalah berkas yang MENDAFTARKAN setiap rahasia yang harus diisi.
#
# Pola negasi baru WAJIB ditambahkan bersama setiap templat baru. Diperiksa
# gerbang `npm run check:templates`.
!.env.example
!.env.prod.example
!*.example
*.log
coverage/
.env.docker

deploy/optional.env

# Cadangan basis data. Berisi DATA PENGGUNA SUNGGUHAN — nama, alamat surel
# terenkripsi, seluruh buku besar. Satu dump yang ter-commit adalah kebocoran
# data yang permanen: menghapusnya di commit berikutnya tidak menghapusnya
# dari riwayat, dan riwayat itu ikut pada setiap kloning.
deploy/backup/*.dump

# Lingkungan uji pemulihan sementara.
.env.restoretest
deploy/backup-test/

# Model bahasa Tesseract, diunduh sendiri oleh `tesseract.js` ke direktori kerja
# pada pemakaian OCR pertama (`createWorker` di `src/modules/receipt/reader.ts`).
# Regenerable, dan bersama-sama berukuran ~7 MB — artefak runtime, bukan sumber.
*.traineddata
